{
  "version": "1.0",
  "ai": {
    "provider": "zhipu",
    "model": "glm-4.7-flash",
    "base_url": "https://open.bigmodel.cn/api/paas/v4",
    "api_key_env": "ZHIPUAI_API_KEY",
    "temperature": 0.3,
    "max_tokens": 8192,
    "thinking": "disabled",
    "throttle_sec": 6,
    "languages": [
      "zh",
      "en"
    ],
    "analysis_concurrency": 1,
    "enrichment_concurrency": 2
  },
  "sources": {
    "github": [
      {
        "type": "user_events",
        "username": "karpathy",
        "enabled": true,
        "category": "ai-insights"
      },
      {
        "type": "repo_releases",
        "owner": "vllm-project",
        "repo": "vllm",
        "enabled": true,
        "category": "ml-systems"
      },
      {
        "type": "repo_releases",
        "owner": "sgl-project",
        "repo": "sglang",
        "enabled": true,
        "category": "ml-systems"
      },
      {
        "type": "repo_releases",
        "owner": "triton-lang",
        "repo": "triton",
        "enabled": true,
        "category": "ml-systems"
      },
      {
        "type": "repo_releases",
        "owner": "pytorch",
        "repo": "pytorch",
        "enabled": true,
        "category": "ml-systems"
      },
      {
        "type": "repo_releases",
        "owner": "huggingface",
        "repo": "transformers",
        "enabled": true,
        "category": "ml-frameworks"
      },
      {
        "type": "repo_releases",
        "owner": "ggml-org",
        "repo": "llama.cpp",
        "enabled": true,
        "category": "local-ai"
      },
      {
        "type": "repo_releases",
        "owner": "ollama",
        "repo": "ollama",
        "enabled": true,
        "category": "local-ai"
      },
      {
        "type": "repo_releases",
        "owner": "NVIDIA",
        "repo": "TensorRT-LLM",
        "enabled": true,
        "category": "ml-systems"
      },
      {
        "type": "repo_releases",
        "owner": "microsoft",
        "repo": "onnxruntime",
        "enabled": true,
        "category": "ml-systems"
      }
    ],
    "hackernews": {
      "enabled": true,
      "fetch_top_stories": 30,
      "min_score": 150,
      "category": "tech-community"
    },
    "rss": [
      {
        "name": "Simon Willison",
        "url": "https://simonwillison.net/atom/everything/",
        "enabled": true,
        "category": "ai-tools"
      },
      {
        "name": "GitHub Trending - Daily",
        "url": "https://mshibanami.github.io/GitHubTrendingRSS/daily/all.xml",
        "enabled": true,
        "category": "github-trending"
      },
      {
        "name": "Semianalysis",
        "url": "https://newsletter.semianalysis.com/feed",
        "enabled": true,
        "category": "semiconductors"
      },
      {
        "name": "PandaBrief - China Semiconductors",
        "url": "https://pandabrief.com/feed.xml",
        "enabled": true,
        "category": "semiconductors"
      },
      {
        "name": "MIIT - Industry Updates",
        "url": "https://www.miit.gov.cn/api-gateway/jpaas-plugins-web-server/front/rss/getinfo?webId=8d828e408d90447786ddbe128d495e9e&columnIds=ca517c97303b40cf80bd668b35f6148f",
        "enabled": true,
        "category": "industry-policy"
      },
      {
        "name": "Google DeepMind News",
        "url": "https://deepmind.google/blog/rss.xml",
        "enabled": true,
        "category": "ai-research"
      },
      {
        "name": "PyTorch Blog",
        "url": "https://pytorch.org/blog/feed/",
        "enabled": true,
        "category": "ml-systems"
      },
      {
        "name": "Cloudflare Blog",
        "url": "https://blog.cloudflare.com/rss/",
        "enabled": true,
        "category": "systems"
      },
      {
        "name": "Google Security Blog",
        "url": "https://security.googleblog.com/feeds/posts/default",
        "enabled": true,
        "category": "security"
      },
      {
        "name": "Rust Blog",
        "url": "https://blog.rust-lang.org/feed.xml",
        "enabled": true,
        "category": "programming"
      },
      {
        "name": "Kubernetes Blog",
        "url": "https://kubernetes.io/feed.xml",
        "enabled": true,
        "category": "cloud-native"
      },
      {
        "name": "Mozilla Hacks",
        "url": "https://hacks.mozilla.org/feed/",
        "enabled": true,
        "category": "web-platform"
      },
      {
        "name": "Python Blog",
        "url": "https://blog.python.org/feeds/posts/default",
        "enabled": true,
        "category": "programming"
      },
      {
        "name": "GitHub Blog",
        "url": "https://github.blog/feed/",
        "enabled": true,
        "category": "developer-tools"
      },
      {
        "name": "LWN.net",
        "url": "https://lwn.net/headlines/full_text?key=${LWN_KEY}",
        "enabled": false,
        "category": "linux-kernel"
      }
    ],
    "reddit": {
      "enabled": true,
      "subreddits": [
        {
          "subreddit": "MachineLearning",
          "enabled": true,
          "sort": "hot",
          "time_filter": "day",
          "fetch_limit": 10,
          "min_score": 60,
          "category": "ai-community"
        },
        {
          "subreddit": "LocalLLaMA",
          "enabled": true,
          "sort": "hot",
          "time_filter": "day",
          "fetch_limit": 10,
          "min_score": 60,
          "category": "local-ai"
        }
      ],
      "users": [],
      "fetch_comments": 10
    },
    "telegram": {
      "enabled": true,
      "channels": [
        {
          "channel": "zaihuapd",
          "enabled": true,
          "fetch_limit": 20,
          "category": "tech-news"
        }
      ]
    },
    "ossinsight": {
      "enabled": true,
      "period": "past_24_hours",
      "languages": [
        "All"
      ],
      "keywords": [
        "artificial intelligence",
        "machine learning",
        "large language model",
        "llm",
        "inference",
        "agentic",
        "ai agent",
        "transformer",
        "vector database",
        "compiler",
        "distributed systems",
        "security",
        "observability"
      ],
      "min_stars": 30,
      "max_items": 12,
      "category": "open-source-trending"
    },
    "google_news": {
      "enabled": true,
      "query": "(\"长鑫科技\" OR \"长鑫存储\" OR CXMT OR \"长江存储\" OR YMTC OR \"国产半导体\" OR \"半导体 IPO\" OR \"芯片 IPO\") -加密货币 -代币 -Hyperliquid -MEXC -Binance",
      "language": "zh-CN",
      "country": "CN",
      "ceid": "CN:zh-Hans",
      "max_results": 100,
      "category": "semiconductors"
    }
  },
  "filtering": {
    "ai_score_threshold": 8.0,
    "filter_mode": "any",
    "score_criteria": [
      {
        "name": "ai_compute",
        "description": "Strong relevance to AI or machine learning models, agents, training, inference, evaluation, safety, open-source model ecosystems, or the computing infrastructure that enables them, with substantive novelty or impact.",
        "threshold": 8.0
      },
      {
        "name": "software_building",
        "description": "Strong relevance to software engineering, developer tools, programming languages, frameworks, open-source releases, mobile or web application development, local-first or data-centric applications, or maintainable project workflows, with concrete technical value.",
        "threshold": 8.0
      },
      {
        "name": "systems_security",
        "description": "Strong relevance to operating systems, especially Windows or Linux, system troubleshooting, cloud-native or distributed systems, networking, observability, reliability, performance, security, privacy, backups, or data safety.",
        "threshold": 8.0
      },
      {
        "name": "chips_hardware",
        "description": "Strong relevance to semiconductors, GPUs, AI accelerators, memory, interconnects, hardware architecture, manufacturing, or hardware-software co-design, with meaningful technical or industry impact.",
        "threshold": 8.0
      },
      {
        "name": "practical_value",
        "description": "Provides unusually actionable and evidence-based value for diagnosing, maintaining, migrating, securing, or improving real software and computing systems; favors reproducible methods, explicit tradeoffs, and data-safe procedures over generic advice or promotion.",
        "threshold": 8.5
      }
    ],
    "time_window_hours": 24,
    "time_window_mode": "previous_calendar_day",
    "time_window_timezone": "Asia/Shanghai",
    "max_items": 12,
    "max_items_per_sub_source": 2,
    "max_analysis_failure_ratio": 0.5,
    "category_groups": {
      "ai_compute": {
        "name": "AI and Compute",
        "limit": 6,
        "categories": [
          "ai-tools",
          "ai-research",
          "ml-systems",
          "ml-frameworks",
          "local-ai",
          "ai-insights",
          "ai-community"
        ]
      },
      "software_building": {
        "name": "Software and Developer Tools",
        "limit": 4,
        "categories": [
          "programming",
          "web-platform",
          "developer-tools",
          "github-trending",
          "open-source-trending",
          "tech-community",
          "tech-news"
        ]
      },
      "systems_security": {
        "name": "Systems and Security",
        "limit": 4,
        "categories": [
          "systems",
          "security",
          "cloud-native",
          "linux-kernel"
        ]
      },
      "chips_hardware": {
        "name": "Chips and Hardware",
        "limit": 3,
        "categories": [
          "semiconductors",
          "industry-policy"
        ]
      }
    },
    "default_group": "other",
    "default_group_limit": 2,
    "candidate_audit_enabled": true,
    "pre_analysis_title_dedup_enabled": true
  },
  "webhook": {
    "enabled": false,
    "url_env": "HORIZON_WEBHOOK_URL",
    "delivery": "summary_and_items",
    "overview_position": "last",
    "platform": "feishu",
    "layout": "collapsible",
    "fallback_layout": "markdown",
    "languages": [
      "zh"
    ],
    "request_body": {
      "msg_type": "interactive",
      "card": {
        "schema": "2.0",
        "config": {
          "wide_screen_mode": true
        },
        "header": {
          "title": {
            "tag": "plain_text",
            "content": "#{message_title}"
          },
          "template": "blue"
        },
        "body": {
          "elements": [
            {
              "tag": "markdown",
              "content": "#{summary}"
            }
          ]
        }
      }
    },
    "headers": ""
  }
}
